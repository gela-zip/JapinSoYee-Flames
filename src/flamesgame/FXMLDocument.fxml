<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<AnchorPane maxHeight="600.0" maxWidth="800.0" minHeight="600.0" minWidth="800.0" 
            prefHeight="600.0" prefWidth="800.0" 
            styleClass="root-pane" 
            stylesheets="@/flamesgame/style.css" 
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="flamesgame.FXMLDocumentController">
    <children>
      <!-- Media View & Background -->
      <MediaView fx:id="mediaView" fitHeight="600.0" fitWidth="800.0" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
      <ImageView fx:id="backgroundImage" fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="false" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

      <!-- Video Controls -->
      <HBox spacing="10.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#handlePauseToggle" styleClass="video-control-button" text="⏸ PAUSE" visible="false" />
            <Button fx:id="skipButton" mnemonicParsing="false" onAction="#handleSkipAction" styleClass="video-control-button" text="⏩ SKIP" visible="false" />
         </children>
      </HBox>

      <!-- Start Button -->
      <Button fx:id="startButton" layoutX="320.0" layoutY="515.0" mnemonicParsing="false" onAction="#handleStartAction" prefHeight="45.0" prefWidth="160.0" styleClass="start-button" text="START" visible="false" AnchorPane.bottomAnchor="40.0" />

      <!-- Character Sprites -->
      <AnchorPane prefHeight="350.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <HBox alignment="BOTTOM_LEFT" spacing="-20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="10.0">
               <children>
                  <ImageView fx:id="charLeftView" fitHeight="260.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
                  <ImageView fx:id="charCenterView" fitHeight="260.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" visible="false" />
               </children>
            </HBox>
            <ImageView fx:id="charRightView" fitHeight="260.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="30.0" />
         </children>
      </AnchorPane>

      <!-- Dialogue Box -->
      <VBox fx:id="dialogueBox" prefHeight="150.0" spacing="6.0" styleClass="dialogue-box" visible="false" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="15.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="speakerLabel" styleClass="speaker-label" text="Speaker" />
            <Label fx:id="dialogueTextLabel" maxWidth="720.0" styleClass="dialogue-text" text="Dialogue text goes here..." wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox alignment="BOTTOM_RIGHT">
               <children>
                  <Button fx:id="dialogueNextButton" mnemonicParsing="false" onAction="#handleNextDialogue" styleClass="dialogue-next-button" text="NEXT ➔" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Gender Selection Overlay -->
      <VBox fx:id="genderSelectionBox" alignment="CENTER" spacing="15.0" visible="false" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
         <children>
            <Label styleClass="selection-heading" text="SELECT CHARACTER PAIRING" />
            <HBox alignment="CENTER" spacing="18.0">
               <children>
                  <!-- Pairing Option 1 -->
                  <VBox alignment="CENTER" spacing="15.0" styleClass="pairing-card">
                     <children>
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <ImageView fx:id="gbPreview1" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                              <ImageView fx:id="gbPreview2" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleGirlBoyChoice" prefHeight="38.0" prefWidth="140.0" styleClass="gradient-button" text="Girl &amp; Boy" />
                     </children>
                  </VBox>
                  <!-- Pairing Option 2 -->
                  <VBox alignment="CENTER" spacing="15.0" styleClass="pairing-card">
                     <children>
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <ImageView fx:id="bbPreview1" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                              <ImageView fx:id="bbPreview2" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleBoyBoyChoice" prefHeight="38.0" prefWidth="140.0" styleClass="gradient-button" text="Boy &amp; Boy" />
                     </children>
                  </VBox>
                  <!-- Pairing Option 3 -->
                  <VBox alignment="CENTER" spacing="15.0" styleClass="pairing-card">
                     <children>
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <ImageView fx:id="ggPreview1" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                              <ImageView fx:id="ggPreview2" fitHeight="85.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleGirlGirlChoice" prefHeight="38.0" prefWidth="140.0" styleClass="gradient-button" text="Girl &amp; Girl" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- FLAMES Input Overlay -->
      <VBox fx:id="flamesInputBox" alignment="CENTER" spacing="14.0" styleClass="flames-input-box" visible="false" AnchorPane.leftAnchor="140.0" AnchorPane.rightAnchor="140.0" AnchorPane.topAnchor="110.0">
         <children>
            <Label styleClass="pink-header-label" text="ENTER NAMES FOR FLAMES" />
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <VBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <ImageView fx:id="p1PortraitView" fitHeight="85.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="player-label" text="PLAYER 1" />
                        <TextField fx:id="player1Input" promptText="Enter Player 1 Name" styleClass="custom-text-field" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <ImageView fx:id="p2PortraitView" fitHeight="85.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="player-label" text="PLAYER 2" />
                        <TextField fx:id="player2Input" promptText="Enter Player 2 Name" styleClass="custom-text-field" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label styleClass="pink-sub-label" text="WHAT IS YOUR EXPECTED RESULT?" />
            <ComboBox fx:id="expectationDropdown" prefWidth="240.0" styleClass="custom-combo-box" />

<Label fx:id="inputErrorLabel"
       text=""
       visible="false"
       managed="false"
       wrapText="true"
       maxWidth="400.0"
       alignment="CENTER"
       styleClass="input-error-label" />

<Button mnemonicParsing="false"
        onAction="#handleFlamesSubmit"
        prefHeight="38.0"
        prefWidth="200.0"
        styleClass="calculate-button"
        text="CALCULATE" />
         
         </children>
      </VBox>

      <!-- Final Outcome Overlay -->
      <VBox fx:id="endingResultBox" alignment="CENTER" spacing="12.0" styleClass="outcome-box" visible="false" AnchorPane.leftAnchor="160.0" AnchorPane.rightAnchor="160.0" AnchorPane.topAnchor="160.0">
         <children>
            <Label fx:id="resultStatusLabel" styleClass="win-label" text="YOU WIN!" />
            <Label fx:id="planetNameLabel" styleClass="white-info-label" text="Landed on: Planet Name" />
            <Label fx:id="flamesResultLabel" styleClass="pink-info-label" text="FLAMES Result: Lovers" />
            <Label fx:id="expectationResultLabel" styleClass="blue-info-label" text="Expected Outcome: Lovers" />
            <Label fx:id="scoreLabel" styleClass="gold-info-label" text="Total Points: 100 / 100" />
         <Button text="CONTINUE"        onAction="#handleContinueToPlanet" />
         </children>
      </VBox>
   </children>
</AnchorPane>